# Server Configuration
NODE_ENV=development
PORT=3000

# Supabase Database Configuration
# Get these from your Supabase project settings > Database
# Connection Pooling URL (for Prisma) - Use the "Connection Pooling" connection string
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true&connection_limit=1

# Direct Connection URL (for migrations and Prisma Studio)
# Use the "Connection string" (not pooling) from Supabase
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# Email Configuration (SendGrid or other SMTP service)
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=noreply@yourchurch.com
FROM_NAME=Your Church Name
CHURCH_NAME=Your Church Name

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
