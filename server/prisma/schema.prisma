generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id             String           @id
  email          String           @unique
  password       String
  name           String
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  members        Member[]
  reg_reps       RegRep[]
  sessions       Session[]
  upload_history upload_history[]

  @@map("admins")
}

model RegRep {
  id        String   @id
  email     String   @unique
  password  String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  admins    Admin    @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@map("reg_reps")
}

model Member {
  id             String       @id
  firstName      String?
  lastName       String?
  email          String       @unique
  phone          String?
  pin            String       @unique
  dateOfBirth    DateTime?
  gender         String?
  address        String?
  membershipType String?
  department     String?
  position       String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdBy      String
  name           String
  pinHash        String?
  attendance     attendance[]
  admins         Admin        @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@map("members")
}

model Session {
  id             String       @id
  name           String?
  description    String?
  date           DateTime?
  time           String?
  location       String?
  secretQuestion String
  secretAnswer   String
  maxAttendees   Int?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdBy      String
  endTime        DateTime
  qrCodeData     String?
  startTime      DateTime
  theme          String
  attendance     attendance[]
  admins         Admin        @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model attendance {
  id          String   @id
  checkedIn   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  memberId    String
  sessionId   String
  checkedInAt DateTime @default(now())
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([memberId, sessionId])
  @@map("attendances")
}

model upload_history {
  id           String   @id
  filename     String
  totalRecords Int
  successful   Int
  failed       Int
  errors       Json?
  createdAt    DateTime @default(now())
  uploadedBy   String
  admins       Admin    @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)
}
